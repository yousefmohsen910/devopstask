pipeline {
    agent any

    environment {
        IMAGE_NAME = "localhost:8082/devops-assessment-app"
        IMAGE_TAG = "latest"
    }

    stages {
        stage("Build Docker Image") {
            steps {
                sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ./assessment/app"
            }
        }

        stage("Test Application") {
            steps {
                sh """
                docker rm -f test-app || true
                docker run -d --name test-app ${IMAGE_NAME}:${IMAGE_TAG}
                sleep 15
                docker exec test-app wget -qO- http://127.0.0.1:3000/health
                docker rm -f test-app
                """
            }
        }

        stage("Login To Nexus") {
            steps {
                withCredentials([usernamePassword(credentialsId: '3f1e9b31-fbf3-4c65-bea5-b49b011ad577', usernameVariable: 'NEXUS_USER', passwordVariable: 'NEXUS_PASS')]) {
                    sh "echo $NEXUS_PASS | docker login localhost:8082 -u $NEXUS_USER --password-stdin"
                }
            }
        }

        stage("Push Image To Nexus") {
            steps {
                sh "docker push ${IMAGE_NAME}:${IMAGE_TAG}"
            }
        }
    }
}
